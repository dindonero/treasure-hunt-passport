# Site URL (used for sitemap, robots.txt, OG tags — set to your production domain)
NEXT_PUBLIC_SITE_URL=https://cadaval.treasurehunt.pt

# Arbitrum Sepolia Configuration
NEXT_PUBLIC_RPC_URL=https://your-rpc-url
NEXT_PUBLIC_CONTRACT_ADDRESS=0xYourContractAddress
NEXT_PUBLIC_CHAIN_ID=0x15d30a9b17
NEXT_PUBLIC_CHAIN_NAME="Nova Cidade Chain"
NEXT_PUBLIC_EXPLORER_URL=https://your-explorer-url

# Signer Private Key (for backend signatures)
SIGNER_PRIVATE_KEY=your_private_key_without_0x_prefix

# Admin Addresses (comma-separated list of additional admin wallet addresses)
ADMIN_ADDRESSES=0xAddress1,0xAddress2

# Backend Private Key (wallet with MINTER_ROLE for minting tokens)
BACKEND_PRIVATE_KEY=your_backend_private_key_without_0x_prefix

# Supabase Configuration
# Neon Postgres (Vercel Neon integration injects this automatically on
# deploys; for local dev copy the pooled connection string from Neon).
# Replaces the former SUPABASE_URL / SUPABASE_ANON_KEY pair.
DATABASE_URL=postgresql://user:password@ep-your-endpoint-pooler.region.aws.neon.tech/neondb?sslmode=require

# JWT Secret (for admin authentication) - generate with: openssl rand -base64 32
JWT_SECRET=your_jwt_secret

# WalletConnect
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=your_walletconnect_project_id

# Thirdweb - required for wallet integration
NEXT_PUBLIC_THIRDWEB_CLIENT_ID=your_thirdweb_client_id
NEXT_PUBLIC_THIRDWEB_FACTORY_ADDRESS=0xYourFactoryAddress

# ERC-4337 Infrastructure (optional, for custom chain bundler)
NEXT_PUBLIC_ENTRYPOINT_ADDRESS=0x5FF137D4b0FDCD49DcA30c7CF57E578a026d2789
NEXT_PUBLIC_BUNDLER_URL=https://your-rpc-url/bundler/

# Cron Secret (auto-set by Vercel Pro for cron auth)
CRON_SECRET=your_cron_secret
