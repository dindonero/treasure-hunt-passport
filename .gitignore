# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
# pnpm is the source of truth (Vercel installs from pnpm-lock.yaml).
# Block accidental npm-/yarn-generated lockfiles.
package-lock.json
yarn.lock

# next.js
/.next/
/out/


# production
/build

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env*
!.env.example

# vercel
.vercel

# claude code session artifacts
.claude

# typescript
*.tsbuildinfo
next-env.d.ts

.idea
.env*.local


# QR poster exports
/qr-posters-portrait
/qr-posters-landscape
/qr-codes-export

# Local scripts (the passport check is tracked)
/scripts/*
!/scripts/test-passport.mjs
!/scripts/e2e.mjs

# foundry artifacts
contracts/broadcast/
contracts/cache/
contracts/out/

# local mcp config
.mcp.json
